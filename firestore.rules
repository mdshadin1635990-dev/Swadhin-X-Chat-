rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'mdshadin1635990@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // --- Validation Helpers ---

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('statusMessage' in data) || data.statusMessage == null || (data.statusMessage is string && data.statusMessage.size() <= 200)) &&
             (!('isOnline' in data) || data.isOnline is bool) &&
             (!('role' in data) || (data.role is string && (data.role == 'user' || data.role == 'admin')));
    }

    function isValidChannel(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.description is string && data.description.size() <= 500 &&
             (!('topic' in data) || data.topic == null || (data.topic is string && data.topic.size() <= 60)) &&
             (!('icon' in data) || data.icon == null || (data.icon is string && data.icon.size() <= 50)) &&
             data.isAnnouncementOnly is bool &&
             data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128 &&
             (!('messageCount' in data) || data.messageCount is int || data.messageCount is number) &&
             (!('lastMessageText' in data) || data.lastMessageText == null || (data.lastMessageText is string && data.lastMessageText.size() <= 500)) &&
             (!('lastMessageSenderName' in data) || data.lastMessageSenderName == null || (data.lastMessageSenderName is string && data.lastMessageSenderName.size() <= 60)) &&
             (!('lastMessageTime' in data) || data.lastMessageTime == null || data.lastMessageTime is timestamp);
    }

    function isValidChannelMessage(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.channelId is string && data.channelId.size() > 0 && data.channelId.size() <= 128 &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             (!('senderPhotoUrl' in data) || data.senderPhotoUrl == null || (data.senderPhotoUrl is string && data.senderPhotoUrl.size() <= 500)) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             data.messageType is string && (data.messageType == 'text' || data.messageType == 'announcement') &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('deleted' in data) || data.deleted is bool);
    }

    function isValidDirectChat(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.participantUids is list && data.participantUids.size() == 2 &&
             (!('lastMessageText' in data) || data.lastMessageText == null || (data.lastMessageText is string && data.lastMessageText.size() <= 500)) &&
             (!('lastMessageSenderId' in data) || data.lastMessageSenderId == null || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128)) &&
             (!('lastMessageTime' in data) || data.lastMessageTime == null || data.lastMessageTime is timestamp);
    }

    function isValidDirectChatMessage(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.chatId is string && data.chatId.size() > 0 && data.chatId.size() <= 128 &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             (!('senderPhotoUrl' in data) || data.senderPhotoUrl == null || (data.senderPhotoUrl is string && data.senderPhotoUrl.size() <= 500)) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000;
    }

    function isValidSystemReport(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.reporterId is string && data.reporterId.size() > 0 && data.reporterId.size() <= 128 &&
             data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 1000 &&
             data.status is string && (data.status == 'pending' || data.status == 'reviewed' || data.status == 'resolved');
    }

    // --- Collections ---

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == userId &&
                       isValidUserProfile(incoming()) &&
                       (isAdmin() || !('role' in incoming()) || incoming().role == 'user') &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       (request.auth.uid == userId || isAdmin()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       (isAdmin() || !('role' in incoming().diff(existing()).affectedKeys())) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      allow delete: if isAdmin() && isValidId(userId);
    }

    // 2. Public / Topic Channels
    match /channels/{channelId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(channelId) &&
                       (isAdmin() || incoming().createdBy == request.auth.uid) &&
                       isValidChannel(incoming()) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       isValidId(channelId) &&
                       isValidChannel(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (existing().createdBy == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'topic', 'icon', 'updatedAt'])) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'lastMessageText', 'lastMessageSenderName', 'lastMessageTime', 'updatedAt'])
                       ) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      allow delete: if isValidId(channelId) && (isAdmin() || (isSignedIn() && existing().createdBy == request.auth.uid));

      // 3. Channel Messages Subcollection
      match /messages/{messageId} {
        allow get, list: if isSignedIn();

        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         incoming().channelId == channelId &&
                         incoming().senderId == request.auth.uid &&
                         isValidChannelMessage(incoming()) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         (!get(/databases/$(database)/documents/channels/$(channelId)).data.isAnnouncementOnly || isAdmin());

        allow update: if isSignedIn() &&
                         isValidId(messageId) &&
                         isValidChannelMessage(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().senderId == existing().senderId &&
                         incoming().channelId == existing().channelId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           isAdmin() ||
                           (existing().senderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'deleted', 'updatedAt']))
                         ) &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow delete: if isValidId(messageId) && (isAdmin() || (isSignedIn() && existing().senderId == request.auth.uid));
      }
    }

    // 4. Direct 1-on-1 Chats
    match /direct_chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) &&
                    (request.auth.uid in resource.data.participantUids || isAdmin());

      allow list: if isSignedIn() &&
                     (request.auth.uid in resource.data.participantUids || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(chatId) &&
                       (request.auth.uid in incoming().participantUids) &&
                       isValidDirectChat(incoming()) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       isValidId(chatId) &&
                       (request.auth.uid in existing().participantUids || isAdmin()) &&
                       isValidDirectChat(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      allow delete: if isValidId(chatId) && (request.auth.uid in existing().participantUids || isAdmin());

      // 5. Direct Chat Messages Subcollection
      match /messages/{messageId} {
        allow get, list: if isSignedIn() &&
                            (request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participantUids || isAdmin());

        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         incoming().chatId == chatId &&
                         incoming().senderId == request.auth.uid &&
                         isValidDirectChatMessage(incoming()) &&
                         (request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participantUids) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow update: if isSignedIn() &&
                         isValidId(messageId) &&
                         (existing().senderId == request.auth.uid || isAdmin()) &&
                         isValidDirectChatMessage(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().senderId == existing().senderId &&
                         incoming().chatId == existing().chatId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow delete: if isValidId(messageId) && (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    // 6. Admin Records
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 7. System Reports & Moderation
    match /system_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) &&
                    (resource.data.reporterId == request.auth.uid || isAdmin());

      allow list: if isSignedIn() &&
                     (resource.data.reporterId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterId == request.auth.uid &&
                       isValidSystemReport(incoming()) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      allow update, delete: if isAdmin() && isValidId(reportId);
    }
  }
}
